main()
  int oid;
  int type;
  int idx;
  string class;

  verify(1);
#  SetColorTheme(16);
#  SetGraphAttribute("AntiAliasing", 1);

  oid = GetFirstObject();
  while (oid != 0)
    type = GetObjectType(oid);
    printf("Type: %d\n", type);
    if (type == eObjectType_SubGraph)
      class = GetObjectClass(oid);
      if (class == "mb2helpclass")
        MoveObject(oid, -0.1, 0.0);
      endif
      if (class == "mb2help")
        MoveObject(oid, -0.1, 0.0);
      endif
    endif

    oid = GetNextObject(oid);    
  endwhile

endmain