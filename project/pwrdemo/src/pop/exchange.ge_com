main()
  int oid;
  int type;
  int idx;
  string class;

  verify(1);
#  SetColorTheme(16);
  SetGraphAttribute("AntiAliasing", 1);

  oid = GetFirstObject();
  while (oid != 0)
    type = GetObjectType(oid);
    printf("Type: %d\n", type);
    if (type == eObjectType_SubGraph)
      class = GetObjectClass(oid);
      if (class == "pwrct_buttonsmalltoggle")
        SetObjectClass(oid, "pwrct_buttonrounded");
        ScaleObject(oid, 0.75, 0.75, 0);
        MoveObject(oid, 3.8, 1.5);
      endif
      if (class == "pwr_mb2helpclass")
	ResetObjectColors(oid);
        SetObjectClass(oid, "mb2helpclass");
      endif
      if (class == "pwr_mb2help")
	ResetObjectColors(oid);
        SetObjectClass(oid, "mb2help");
      endif
      if (class == "pwrct_buttoncommand")
        SetObjectClass(oid, "pwrct_buttonrounded");
      endif
      if (class == "pwrct_buttontoggle")
        SetObjectClass(oid, "pwrct_buttonrounded");
      endif
      if (class == "pwr_indround")
        ScaleObject(oid, 1.2, 1.2, 0);
        MoveObject(oid, -3.8, -1.4);
      endif
      if (class == "pwrct_indroundgreenbg")
        ScaleObject(oid, 1.2, 1.2, 0);
        MoveObject(oid, -3.8, -1.4);
      endif
    endif

    oid = GetNextObject(oid);    
  endwhile

endmain