# Normalize RemoteAccessType to SSH.
function int update_remoteaccess(string name)
  string attr;
  int access;

  attr = name + ".RemoteAccessType";
  access = GetAttribute(attr);
  if (access != 0)
    printf("Updating value %s: %d -> 0\n", attr, access);
    SetAttribute(attr, 0);
  endif
endfunction

# Replace the old reserved compatibility bit with AuthorizedKeysFile.
function int update_distribute_components(string name)
  string child;
  string class;
  string attr;
  int components;
  int new_components;

  child = GetChild(name);
  while (child != "")
    class = GetObjectClass(child);
    if (class == "Distribute")
      attr = child + ".Components";
      components = GetAttribute(attr);
      new_components = components | 8192;
      if ((components & 1024) != 0)
        new_components = new_components - 1024;
      endif
      if (components != new_components)
        printf("Updating value %s: %d -> %d\n", attr, components,
            new_components);
        SetAttribute(attr, new_components);
      endif
      break;
    endif
    child = GetNextSibling(child);
  endwhile
endfunction

function int update_nodeconfigs()
  string name = GetClassList("NodeConfig");
  while (name != "")
    printf("Updating NodeConfig %s\n", name);
    update_remoteaccess(name);
    update_distribute_components(name);
    name = GetNextObject(name);
  endwhile

  name = GetClassList("SevNodeConfig");
  while (name != "")
    printf("Updating SevNodeConfig %s\n", name);
    update_remoteaccess(name);
    update_distribute_components(name);
    name = GetNextObject(name);
  endwhile
endfunction

main()
  update_nodeconfigs();
  save /quiet
endmain
