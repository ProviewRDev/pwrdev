"od1 = od2 = 0;
if (d1) {
 if (A1 > A2) {
  od1 = 1;
  if (A1 >= A3) OA1 = -A4;
  else OA1 = -A4 * sqrt(A1 / A3);  
  if(OA1 > -A5) OA1 = -A5;
 } else if (A1 < -A2) {
  od2 = 1;
  if (A1<= -A3) OA1 = A4;
  else OA1 = A4 * sqrt(-A1 / A3);    
  if(OA1 < A5) OA1 = A5;
 } else OA1 = 0;
} else OA1 = 0.0;
"
