          EndBody
        EndObject
        !/**
        !  Text string to show the current mode in the object symbol.
        !  Contains "L" in local mode, "M" in manual mode and is empty in auto mode.
        !*/
        Object IndMode $Attribute 25 08-SEP-2005 13:01:47.00
          Body SysBody 20-DEC-2005 15:30:34.38
            Attr PgmName = "IndMode"
            Attr Size = 8
            Attr Flags = 1024
            Attr TypeRef = "pwrs:Type-$String8"
          EndBody
        EndObject
        !/**
        !  @Summary The plc function object connected to this object.
        !  The plc function object connected to this object.
        !  This attribute is set when the function object is connected from
        !  the plc editor by the connect function.
        !*/
        Object PlcConnect $Attribute 27 08-SEP-2005 13:01:47.00
          Body SysBody 01-JAN-1970 01:00:00.00
            Attr PgmName = "PlcConnect"
            Attr Size = 24
            Attr TypeRef = "pwrs:Type-$AttrRef"
          EndBody
        EndObject
      EndObject
