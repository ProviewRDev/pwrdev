            Attr PgmName = "Value"
            Attr Flags = 8192
            Attr TypeRef = "pwrs:Type-$Float32"
          EndBody
        EndObject
        !/**
        !  If true, the sinus component is added to the simulated value.
        !*/
        Object SinusCurve $Intern 3 08-SEP-2005 13:01:47.00
          Body SysBody 01-JAN-1970 01:00:00.00
            Attr PgmName = "SinusCurve"
            Attr TypeRef = "pwrs:Type-$Boolean"
          EndBody
        EndObject
        !/**
        !  If true, the sawtooth component is added to the simulated value.
        !*/
        Object SawToothedCurve $Intern 4 08-SEP-2005 13:01:47.00
          Body SysBody 01-JAN-1970 01:00:00.00
            Attr PgmName = "SawToothedCurve"
            Attr TypeRef = "pwrs:Type-$Boolean"
          EndBody
        EndObject
        !/**
        !  If true, the random component is added to the simulated value.
        !*/
        Object RandomCurve $Intern 5 08-SEP-2005 13:01:47.00
          Body SysBody 01-JAN-1970 01:00:00.00
            Attr PgmName = "Random"
            Attr TypeRef = "pwrs:Type-$Boolean"
          EndBody
        EndObject
        !/**
        !  If true, the simulated value is set to zero.
        !*/
        Object DisableValue $Intern 6 08-SEP-2005 13:01:47.00
          Body SysBody 01-JAN-1970 01:00:00.00
            Attr PgmName = "DisableValue"
            Attr TypeRef = "pwrs:Type-$Boolean"
          EndBody
        EndObject
        !/**
        !  Period of sinus and saw toothed component.
        !*/
        Object Period $Intern 9 08-SEP-2005 13:01:47.00
          Body SysBody 01-JAN-1970 01:00:00.00
            Attr PgmName = "Period"
            Attr TypeRef = "pwrs:Type-$Float32"
          EndBody
        EndObject
        !/**
