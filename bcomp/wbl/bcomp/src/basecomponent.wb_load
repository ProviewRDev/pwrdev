          Attr StructName = "BaseContactorFo"
          Attr NextAix = "_X13"
        EndBody
        !/**
        !  Input to energize the contactor. In normal operation with one
        !  order output, the order output follows the On input. 
        ! 
        !  If two order outputs are configured, the on order output will
        !  be pulsed on positive edge.
        !*/
        Object On $Input 6 04-OCT-2005 09:00:02.99
          Body SysBody 29-NOV-2005 08:51:15.21
            Attr PgmName = "On"
            Attr Flags = 8192
            Attr TypeRef = "pwrs:Type-$Boolean"
            Attr GraphName = "on"
          EndBody
        EndObject
        !/**
        !  Disable supervision. Alarm messages are suppressed.
        !*/
        Object DisableSup $Input 10 01-OCT-2007 10:22:16.66
          Body SysBody 01-OCT-2007 10:22:10.45
            Attr PgmName = "DisableSup"
            Attr Flags = 8192
            Attr TypeRef = "pwrs:Type-$Boolean"
            Attr GraphName = "dis"
          EndBody
        EndObject
        !/**
        !  Input to turn off the contactor, when a configuration with
        !  two order outputs are selected.
        ! 
        !  The off order output is pulsed on positive edge of the Off 
        !  input.
        ! 
        !  If OpNoOffPulse is configured, this input is not used.
        !*/
        Object Off $Input 12 25-MAR-2010 15:13:09.52
          Body SysBody 25-MAR-2010 15:13:15.48
            Attr PgmName = "Off"
            Attr Flags = 8192
            Attr TypeRef = "pwrs:Type-$Boolean"
            Attr GraphName = "off"
          EndBody
        EndObject
        !/**
        !  Output attribute for the contactor feedback.
        !  If no contactor feedback is configured, the order output
        !  is used instead.
        !*/
        Object Feedback $Output 7 04-OCT-2005 09:00:02.99
          Body SysBody 30-JUN-2016 14:40:46.46
            Attr PgmName = "Feedback"
            Attr Flags = 1028
            Attr TypeRef = "pwrs:Type-$Boolean"
            Attr GraphName = "fb"
          EndBody
        EndObject
        !/**
        !  Error output. The output is high in 2 s when the contactor feedback
        !  is lost.
        !*/
        Object Error $Output 8 04-OCT-2005 09:00:02.99
          Body SysBody 30-JUN-2016 14:40:46.46
            Attr PgmName = "Error"
            Attr Flags = 1028
            Attr TypeRef = "pwrs:Type-$Boolean"
            Attr GraphName = "err"
          EndBody
        EndObject
