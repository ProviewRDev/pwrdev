        Object LocMode $Input 20 05-OCT-2005 13:26:14.71
          Body SysBody 05-OCT-2005 13:26:14.71
            Attr PgmName = "LocMode"
            Attr Flags = 8192
            Attr TypeRef = "pwrs:Type-$Boolean"
            Attr GraphName = "loc"
          EndBody
        EndObject
        !/**
