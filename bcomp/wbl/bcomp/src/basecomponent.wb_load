          Body SysBody 01-JAN-1970 01:00:00.00
            Attr PgmName = "ExtStart"
            Attr Flags = 8192
            Attr TypeRef = "pwrs:Type-$Boolean"
            Attr GraphName = "est"
          EndBody
        EndObject
        !/**
