          EndBody
        EndObject
        !/**
        !  Alarm text when local mode is active.
        !*/
        Object AlarmLocalMode $Attribute 14 08-SEP-2005 13:01:47.00
          Body SysBody 01-JAN-1970 01:00:00.00
