            Body DevBody 12-MAR-2008 13:26:09.10
              Buffer PlcNode
                Attr object_type = 11
                Attr cid = "pwrb:Class-CArithm"
                Attr oid = "BaseComponent:Class-BaseFcPPO5Fo-Code-W-Parameter"
                Attr x = 2.100000e+00
