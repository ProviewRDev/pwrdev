          EndBody
        EndObject
        !/**
        !  Configuration attribute to disable manual mode.
        !  No buttons are present in the object graph.
        !*/
        Object OpAutoOnly $Attribute 8 08-SEP-2005 13:01:47.00
          Body SysBody 30-JUN-2016 14:40:45.43
            Attr PgmName = "OpAutoOnly"
            Attr Size = 4
            Attr Flags = 4
            Attr TypeRef = "pwrs:Type-$Boolean"
          EndBody
        EndObject
        !/**
        !  Configures that OpRefMan is updated with the auto reference value
        !  in Auto mode.
        !*/
        Object OpUpdateManRef $Attribute 9 08-SEP-2005 13:01:47.00
          Body SysBody 30-JUN-2016 14:40:45.43
            Attr PgmName = "OpUpdateManRef"
            Attr Size = 4
            Attr Flags = 4
            Attr TypeRef = "pwrs:Type-$Boolean"
          EndBody
        EndObject
        !/**
        !  Configuration attribute to not handle Local mode. 
        !*/
        Object OpNoLocal $Attribute 13 08-SEP-2005 13:01:47.00
          Body SysBody 30-JUN-2016 14:40:45.44
            Attr PgmName = "OpNoLocal"
            Attr Size = 4
            Attr Flags = 4
            Attr TypeRef = "pwrs:Type-$Boolean"
          EndBody
        EndObject
        !/**
        !  Manual analog reference set from the object graph.
        !  In auto mode the value is automatically updated with the auto
        !  reference to enable smooth mode switching when OpUpdateManRef 
        !  is configured to 1.
        !*/
        Object OpRefMan $Attribute 5 08-SEP-2005 13:01:47.00
          Body SysBody 30-JUN-2016 14:40:45.44
            Attr PgmName = "OpRefMan"
            Attr Size = 4
            Attr Flags = 4
            Attr TypeRef = "pwrs:Type-$Float32"
          EndBody
        EndObject
        !/**
        !  Min value for manual reference.
        !*/
        Object OpMinRefMan $Attribute 6 08-SEP-2005 13:01:47.00
          Body SysBody 30-JUN-2016 14:40:45.44
            Attr PgmName = "OpMinRefMan"
            Attr Size = 4
            Attr Flags = 4
            Attr TypeRef = "pwrs:Type-$Float32"
          EndBody
        EndObject
        !/**
        !  Max value for manual reference.
        !*/
        Object OpMaxRefMan $Attribute 7 08-SEP-2005 13:01:47.00
          Body SysBody 30-JUN-2016 14:40:45.44
            Attr PgmName = "OpMaxRefMan"
            Attr Size = 4
            Attr Flags = 4
            Attr TypeRef = "pwrs:Type-$Float32"
          EndBody
        EndObject
        !/**
        !  Configuration attribute to disable the alarm when local mode is activated.
        !*/
        Object OpDisableLocalAlarm $Attribute 15 09-FEB-2010 14:05:29.14
          Body SysBody 30-JUN-2016 14:40:45.44
            Attr PgmName = "OpDisableLocalAlarm"
            Attr Size = 4
            Attr Flags = 4
            Attr TypeRef = "pwrs:Type-$Boolean"
          EndBody
        EndObject
        !/**
        !  Text string to show the current mode in the object symbol.
        !  Contains "L" in local mode, "M" in manual mode and is empty in auto mode.
        !*/
        Object IndMode $Attribute 10 08-SEP-2005 13:01:47.00
          Body SysBody 20-DEC-2005 15:21:08.01
            Attr PgmName = "IndMode"
            Attr Size = 8
            Attr Flags = 1024
