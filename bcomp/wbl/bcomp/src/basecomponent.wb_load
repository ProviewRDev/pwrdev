    !/**
    !  @Version 1.0
    !  @Group Simulate
    !  @Code basecomponent_basesensorsim.pdf
    !  @Summary Plc simulation object to BaseSensor.
    !  Plc simulation object to BaseSensor.
    ! 
    !  @image orm_basesensorsim_fo.gif
    ! 
    !  @b Object Graph
    !  @image orm_basesensorsim_og.png
    ! 
    !  The sensor value is the sum of
    !  - the Value input, which can be connected in the plc, or given an
    !    an initial value and modified by the slider in the object graph.
    !  - a bias component.
    !  - a sinus component.
    !  - a sawtooth component.
    !  - a random component.
    !  
    !  @h1 Configuration
    !  Connect the function object to an object of class or subclass of
    !  BaseSensor.
    ! 
    !  @b See also
    !  @classlink BaseSensor basecomponent_basesensor.html
    !*/
    Object BaseSensorSim $ClassDef 40 04-OCT-2005 14:04:09.72
      Body SysBody 25-OCT-2022 09:56:11.28
        Attr Editor = 0
        Attr Method = 0
        Attr Flags = 262288
      EndBody
