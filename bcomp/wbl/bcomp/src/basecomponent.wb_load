        !*/
        Object Bias $Intern 10 08-SEP-2005 13:01:47.00
          Body SysBody 01-JAN-1970 01:00:00.00
            Attr PgmName = "Bias"
            Attr TypeRef = "pwrs:Type-$Float32"
          EndBody
        EndObject
        !/**
