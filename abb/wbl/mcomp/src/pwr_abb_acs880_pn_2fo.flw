"Interface graphname:

INPUT PINS:
PowerOn = pwo
Start (OFF1 control) = sta 
RefSpeed = REF
Not OFF2 Emergency coast to stop = nof2  DEFAULT 1
Not OFF3 Emergency ramp stop = nof3  DEFAULT 1
Enable operation (normal start/stop) = eno
Not RampOutZero (forze to 0) = roz DEFAULT 1
Not RampHold = rh DEFAULT 1
Not RampInZero (force ramping) = riz DEFAULT 1

OUTPUT PINS:
ReadyRemote = rdy
Run = run
Digital in 1 to 6 = di1. di2...
Digital in Interlock = diil
Safe Torque Off (digtal In1 & In2) = sto
ReadyForRef = rdyref

